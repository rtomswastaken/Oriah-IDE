/* Oriah IDE - Cursor-Inspired Terminal Design System */

Screen {
    background: #0d0f14;
    color: #e2e8f0;
    layout: vertical;
}

/* Header & Status bar */
#app-header {
    dock: top;
    height: 1;
    background: #131722;
    color: #94a3b8;
    padding: 0 1;
}

#app-header .app-title {
    text-style: bold;
    color: #60a5fa;
}

#app-header .app-version {
    color: #64748b;
}

#app-status-bar {
    dock: bottom;
    height: 1;
    background: #11141d;
    color: #64748b;
    padding: 0 1;
}

/* Main 4-Quadrant Workspace */
#workspace-grid {
    layout: horizontal;
    height: 1fr;
    width: 100%;
}

/* Left Column */
#left-column {
    width: 25%;
    min-width: 30;
    max-width: 45;
    height: 100%;
    layout: vertical;
    border-right: vkey #1e2433;
}

#directory-container {
    height: 60%;
    layout: vertical;
    border-bottom: hkey #1e2433;
    background: #131722;
}

#checklist-container {
    height: 40%;
    layout: vertical;
    background: #131722;
}

/* Right Column */
#right-column {
    width: 1fr;
    height: 100%;
    layout: vertical;
}

#editor-container {
    height: 60%;
    layout: vertical;
    border-bottom: hkey #1e2433;
    background: #0d0f14;
}

#bottom-right-container {
    height: 40%;
    layout: vertical;
    background: #131722;
}

/* Section Header Titles */
.panel-header {
    height: 3;
    background: #181d2a;
    color: #cbd5e1;
    padding: 0 1;
    align-vertical: middle;
    border-bottom: solid #1e2433;
}

.panel-title {
    text-style: bold;
    color: #e2e8f0;
}

.panel-subtitle {
    color: #64748b;
    margin-left: 1;
}

/* Directory Tree */
#directory-tree {
    background: #131722;
    color: #94a3b8;
    height: 1fr;
    scrollbar-color: #334155;
}

#directory-tree > .tree--cursor {
    background: #1e293b;
    color: #38bdf8;
    text-style: bold;
}

/* Checklist / Report */
#checklist-scroll {
    height: 1fr;
    padding: 0 1;
    overflow-y: auto;
}

.checklist-row {
    height: auto;
    margin: 0 0 1 0;
    padding: 0 1;
    background: #181d2a;
    border: solid transparent;
}

.checklist-row:hover {
    background: #1e293b;
}

.checklist-row.done {
    opacity: 60%;
}

.checklist-checkbox {
    color: #60a5fa;
}

.checklist-title {
    color: #f1f5f9;
}

.checklist-title.done {
    text-style: strike;
    color: #64748b;
}

#checklist-progress-bar {
    margin: 0 1;
    height: 1;
    color: #38bdf8;
}

/* Code Editor */
#editor-tabs-bar {
    height: 3;
    background: #10141e;
    layout: horizontal;
    overflow-x: auto;
    border-bottom: solid #1e2433;
}

.editor-tab-btn {
    height: 3;
    min-width: 16;
    padding: 0 1;
    background: #141824;
    color: #94a3b8;
    border-right: solid #1e2433;
    border-top: solid transparent;
}

.editor-tab-btn:hover {
    background: #1a2030;
    color: #cbd5e1;
}

.editor-tab-btn.active-tab {
    background: #0d0f14;
    color: #38bdf8;
    text-style: bold;
    border-top: solid #38bdf8;
}

#code-text-area {
    height: 1fr;
    background: #0d0f14;
    color: #f8fafc;
    border: none;
}

#editor-info-bar {
    height: 1;
    background: #10141e;
    color: #64748b;
    padding: 0 1;
    layout: horizontal;
}

/* Bottom Right Dual-Mode (Agent Mode / Terminal) */
#bottom-mode-tabs {
    height: 3;
    background: #131722;
    layout: horizontal;
    border-bottom: solid #1e2433;
    padding: 0 1;
}

.mode-tab-btn {
    height: 3;
    padding: 0 2;
    background: #181d2a;
    color: #94a3b8;
    margin-right: 1;
    border-top: solid transparent;
}

.mode-tab-btn:hover {
    background: #1e293b;
    color: #e2e8f0;
}

.mode-tab-btn.active-mode {
    background: #1e293b;
    color: #60a5fa;
    text-style: bold;
    border-top: solid #60a5fa;
}

/* Agent Mode Panel */
#agent-mode-panel {
    height: 1fr;
    layout: vertical;
    background: #131722;
}

#agent-cards-scroll {
    height: 1fr;
    layout: horizontal;
    padding: 1;
    overflow-x: auto;
    overflow-y: hidden;
}

.agent-card {
    width: 28;
    height: 100%;
    margin-right: 2;
    background: #181d2a;
    border: solid #273142;
    padding: 1;
    layout: vertical;
}

.agent-card:hover {
    border: solid #475569;
    background: #1c2333;
}

.agent-card.active-agent {
    border: double #60a5fa;
    background: #192233;
}

.agent-card-header {
    height: 2;
    layout: horizontal;
}

.agent-card-avatar {
    width: 3;
    color: #f8fafc;
}

.agent-card-name {
    text-style: bold;
    color: #f1f5f9;
    width: 1fr;
}

.agent-card-badge {
    height: 1;
    padding: 0 1;
    background: #1e293b;
    color: #38bdf8;
    text-style: bold;
    margin-top: 1;
}

.agent-card-role {
    color: #94a3b8;
    margin-top: 1;
}

.agent-card-status {
    color: #10b981;
    margin-top: 1;
    text-style: italic;
}

/* Plus Add Agent Card */
.add-agent-card, #add-agent-button-card {
    width: 14;
    height: 100%;
    background: #181d2a;
    border: dashed #3b4252;
    align: center middle;
    content-align: center middle;
}

.add-agent-card:hover, #add-agent-button-card:hover {
    border: solid #60a5fa;
    background: #1e293b;
}

.add-agent-icon {
    text-style: bold;
    color: #60a5fa;
    content-align: center middle;
}

.add-agent-text {
    color: #94a3b8;
    content-align: center middle;
}

/* Agent Prompt Bar */
#agent-prompt-bar {
    height: 3;
    background: #181d2a;
    layout: horizontal;
    padding: 0 1;
    border-top: solid #1e2433;
}

#agent-prompt-input {
    width: 1fr;
    background: #0d0f14;
    border: none;
    color: #f8fafc;
}

#agent-prompt-send {
    min-width: 10;
    margin-left: 1;
    background: #2563eb;
    color: #ffffff;
    text-style: bold;
}

/* Terminal / Console Panel */
#terminal-panel {
    height: 1fr;
    layout: vertical;
    background: #090b10;
}

#terminal-log {
    height: 1fr;
    background: #090b10;
    color: #cbd5e1;
    padding: 0 1;
    overflow-y: auto;
}

#terminal-input-bar {
    height: 3;
    background: #121622;
    layout: horizontal;
    padding: 0 1;
    border-top: solid #1e2433;
}

.terminal-prompt-label {
    width: 3;
    color: #10b981;
    text-style: bold;
    content-align: center middle;
}

#terminal-command-input {
    width: 1fr;
    background: #090b10;
    border: none;
    color: #f8fafc;
}

#terminal-clear-btn {
    min-width: 8;
    margin-left: 1;
    background: #1e293b;
    color: #94a3b8;
}

/* Modal Dialog */
AddAgentModal {
    align: center middle;
}

#modal-dialog-box {
    width: 60;
    height: auto;
    background: #181d2a;
    border: thick #3b82f6;
    padding: 1 2;
}

.modal-title {
    text-style: bold;
    color: #60a5fa;
    margin-bottom: 1;
    content-align: center middle;
}

.modal-field-label {
    color: #94a3b8;
    margin-top: 1;
}

.modal-input {
    background: #0d0f14;
    color: #f8fafc;
    border: solid #273142;
    margin-bottom: 1;
}

#modal-buttons {
    layout: horizontal;
    align: right middle;
    margin-top: 1;
}

.modal-btn {
    min-width: 12;
    margin-left: 1;
}

#modal-confirm-btn {
    background: #2563eb;
    color: #ffffff;
    text-style: bold;
}
